ZED_KEY_ENV = re.sub(r"[^A-Za-z0-9]+", "_", PROVIDER_NAME).upper() + "_API_KEY"


class Zed(Integration):
    """No Ollama counterpart. Zed's own OpenAI-compatible provider, named
    after the Hub, in settings.json, with the biggest model as the agent's
    default and the Hub's MCP server under context_servers.

    Zed never reads a provider's key from settings.json, only from the OS
    keychain or from `<PROVIDER ID>_API_KEY` (here SPARK_AI_HUB_API_KEY) in
    the environment it started with. On Linux and Windows the zed CLI starts
    the app as its child, so `sah zed` passes the variable (a Zed that is
    already open must be quit first). On macOS the CLI opens the app through
    LaunchServices, which hands it none of the CLI's environment, so the key
    goes in the login keychain instead, as the same internet password Zed
    writes itself when you paste a key: server = the provider's api_url,
    account = "Bearer"."""
    name, display, binary = "zed", "Zed", "zed"
    description = "Use Hub models in the Zed editor"
    kind = "Desktop"
    install_hint = "https://zed.dev/download"
    writes_config = True
    opens_folder = True

    def app_bundle(self) -> Path | None:
        for root in (Path("/Applications"), Path.home() / "Applications"):
            for name in ("Zed.app", "Zed Preview.app"):
                if (root / name / "Contents/MacOS/cli").is_file():
                    return root / name
        return None

    def find_binary(self) -> str | None:
        """PATH first (some Linux packages name the CLI zeditor), then where
        the installers put it. The macOS app does not add `zed` to PATH until
        you run "zed: install cli", so the bundle's own CLI is used."""
        for name in ("zed", "zeditor"):
            if path := shutil.which(name):
                return path
        if sys.platform == "darwin":
            app = self.app_bundle()
            return str(app / "Contents/MacOS/cli") if app else None
        fallback = Path.home() / ".local/bin/zed"
        return str(fallback) if fallback.is_file() else None

    def keychain(self, action: str) -> bool:
        """add/delete the macOS keychain entry Zed reads the key from."""
        args = ["security", f"{action}-internet-password", "-s", api_base(), "-a", "Bearer"]
        if action == "add":
            # -T lets Zed itself read it; without it macOS asks on first use.
            app = self.app_bundle()
            args += ["-U", "-w", API_KEY, *(["-T", str(app)] if app else [])]
        try:
            done = subprocess.run(args, capture_output=True, text=True)
        except OSError:
            return False
        return done.returncode == 0

    def config_path(self) -> Path:
        if sys.platform == "win32":
            return Path(os.environ.get("APPDATA") or Path.home()) / "Zed" / "settings.json"
        base = os.environ.get("XDG_CONFIG_HOME") if sys.platform.startswith("linux") else None
        return (Path(base) if base else Path.home() / ".config") / "zed" / "settings.json"

    def files(self) -> dict[str, Path]:
        return {"zed": self.config_path()}

    @staticmethod
    def entry(model: Model) -> dict:
        return {
            "name": model.name,
            "max_tokens": model.context(),
            "max_output_tokens": model.max_output(),
            "capabilities": {
                "tools": model.has("tools"),
                "images": model.has("vision"),
                "parallel_tool_calls": False,
                "prompt_cache_key": False,
            },
        }

    def configure(self, model: Model) -> None:
        cfg = read_json(self.config_path())
        models = cfg.get("language_models") if isinstance(cfg.get("language_models"), dict) else {}
        compatible = (models.get("openai_compatible")
                      if isinstance(models.get("openai_compatible"), dict) else {})
        compatible[PROVIDER_NAME] = {
            "api_url": api_base(),
            "available_models": [self.entry(m) for m in model.all],
        }
        models["openai_compatible"] = compatible
        cfg["language_models"] = models
        agent = cfg.get("agent") if isinstance(cfg.get("agent"), dict) else {}
        agent["default_model"] = {"provider": PROVIDER_NAME, "model": model.name}
        cfg["agent"] = agent
        servers = cfg.get("context_servers") if isinstance(cfg.get("context_servers"), dict) else {}
        servers[MCP_SERVER] = {"url": mcp_url(), "headers": mcp_headers()}
        cfg["context_servers"] = servers
        write_json(self.config_path(), cfg)
        if sys.platform == "darwin" and not self.keychain("add"):
            print("Note: could not save the key in your keychain; Zed will ask for it "
                  f"(sah {self.name} --status shows it).", file=sys.stderr)

    def restore(self) -> None:
        super().restore()
        if sys.platform == "darwin" and self.keychain("delete"):
            print("  Key removed from your keychain.")

    def wired(self) -> bool:
        compatible = (read_json(self.config_path()).get("language_models") or {}).get("openai_compatible")
        provider = compatible.get(PROVIDER_NAME) if isinstance(compatible, dict) else None
        return isinstance(provider, dict) and provider.get("api_url") == api_base()

    def env(self, model: Model) -> dict:
        return {ZED_KEY_ENV: API_KEY}

    def extras(self) -> tuple[tuple[str, str], ...]:
        if sys.platform == "darwin":
            return (("Key", f"login keychain, server {api_base()}, account Bearer"),)
        return (("Key", f"{ZED_KEY_ENV}, set only when sah starts Zed: quit Zed, then run sah zed"),)


