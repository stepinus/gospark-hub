#!/usr/bin/env python3
"""sah — Spark AI Hub launcher.

One command per coding agent. `sah opencode` launches OpenCode wired to
whatever LLM the Hub is currently serving; `sah codex` does the same for Codex.
`sah env` / `sah info` print connection details for any other OpenAI-compatible
client (Zed, Cursor, Continue, Chatbox, ...).

The integration set and the way each client is wired mirror Ollama's launcher
(github.com/ollama/ollama, cmd/launch/) so that a client working with
`ollama launch <x>` works with `sah <x>`. Ollama's design is followed even
where sah previously did something of its own; the handful of deliberate
divergences are each commented with the reason at the point of divergence.

Hub URL discovery, in order: $SAH_HUB, ~/.config/sah/hub, http://localhost:9000.
The saved list is not frozen at install time: the Hub restates its own current
addresses on every /api/system/connect call, so a changed server IP — or a
laptop that has come back onto the Hub's LAN — is picked up automatically.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid
from pathlib import Path

# tomllib is stdlib only on Python 3.11+. Fall back to the `tomli` backport, or
# to None (validation becomes a no-op) so sah still runs on older Pythons such
# as the one shipped with Synology DSM.
try:
    import tomllib
except ModuleNotFoundError:  # pragma: no cover
    try:
        import tomli as tomllib  # type: ignore
    except ModuleNotFoundError:
        tomllib = None  # type: ignore

DEFAULT_HUB = "http://localhost:9000"
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "sah"
CONFIG_FILE = CONFIG_DIR / "hub"

# The provider id sah registers inside each client's config. Kept identical
# across clients so a config is recognisable as sah-owned at a glance.
PROVIDER = "sah"
PROVIDER_NAME = "Spark AI Hub"

KEY_FILE = CONFIG_DIR / "key"


def _load_api_key() -> str:
    """This device's Hub API key.

    A Hub that is exposed to the internet issues one key per person, so the key
    is per-install state, not a constant. $SAH_API_KEY wins (handy for one-off
    shells and CI); otherwise it comes from the file the installer wrote.

    The literal "sah" is the fallback for a Hub running with authentication
    turned off, which accepts any value — that is what every version of sah
    before per-user keys always sent.
    """
    if v := os.environ.get("SAH_API_KEY"):
        return v.strip()
    try:
        if KEY_FILE.is_file():
            if key := KEY_FILE.read_text().strip():
                return key
    except OSError:
        pass
    return "sah"


API_KEY = _load_api_key()

_hub_cache: str | None = None


# ---------------------------------------------------------------- hub discovery


def _hub_candidates() -> list[str]:
    """Ordered Hub URLs to try. $SAH_HUB wins; otherwise every non-empty line of
    the config file (stable name first, IP last — written at install time)."""
    if v := os.environ.get("SAH_HUB"):
        return [v.rstrip("/")]
    if CONFIG_FILE.is_file():
        urls = [ln.strip().rstrip("/") for ln in CONFIG_FILE.read_text().splitlines()]
        if urls := [u for u in urls if u]:
            return urls
    return [DEFAULT_HUB]


def _is_alive(base: str, timeout: float = 1.5) -> bool:
    """Can we open a TCP connection to this Hub's port?

    A TCP connect, not an HTTP request: a live Hub accepts the connection
    instantly even when its app layer is briefly saturated (installs, log
    streaming), whereas a stale address times out. An HTTP probe would give
    false negatives under load and wrongly fall through to a dead address.

    IPv4 is tried first: mDNS names can resolve to a mix of IPv4, IPv6 and
    docker-bridge addresses, and the Hub binds 0.0.0.0, so a stray IPv6 record
    would otherwise eat the whole budget and produce a false "dead" verdict.
    """
    parts = urllib.parse.urlsplit(base)
    host = parts.hostname
    if not host:
        return False
    port = parts.port or (443 if parts.scheme == "https" else 80)
    try:
        infos = socket.getaddrinfo(host, port, proto=socket.IPPROTO_TCP)
    except OSError:
        return False
    infos.sort(key=lambda i: 0 if i[0] == socket.AF_INET else 1)
    for family, socktype, proto, _canon, sockaddr in infos:
        s = socket.socket(family, socktype, proto)
        s.settimeout(timeout)
        try:
            s.connect(sockaddr)
            return True
        except OSError:
            continue
        finally:
            s.close()
    return False


# How long a saved candidate list is trusted before we ask the Hub to confirm
# it. The Hub's LAN IP can change under it at any time (DHCP), so the list is
# refreshed periodically rather than only at install time — but a `sah` command
# is interactive, so this is not something to re-check on every invocation.
HUB_REFRESH_TTL = 6 * 3600


def _config_age() -> float | None:
    """Seconds since the candidate list was last written, or None if unsaved."""
    try:
        return time.time() - CONFIG_FILE.stat().st_mtime
    except OSError:
        return None


def _refresh_candidates(base: str) -> str:
    """Ask the Hub where it is right now; re-sort and re-save our address list.

    The install-time list goes stale in two ways the client cannot see for
    itself. The Hub's LAN IP changes when its DHCP lease moves, and — more
    quietly — a laptop that saved a Tailscale or tunnel address comes home and
    keeps using it, sending every token out to the internet and back to a box
    on the same switch. Only the Hub can settle either question: it recomputes
    its own addresses per request, and it can see our source address, so it
    knows whether we are on its LAN.

    Returns the address to use for the rest of this run (the current one unless
    a local address answered and is closer).
    """
    try:
        req = hub_request(f"{base}/api/system/connect")
        with urllib.request.urlopen(req, timeout=3) as r:
            info = json.loads(r.read())
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError, OSError):
        return base  # offline, old Hub, or bad key — keep what already works

    fresh = [c["url"].rstrip("/") for c in info.get("candidates") or []
             if c.get("url")]
    if not fresh:
        return base
    local = [c["url"].rstrip("/") for c in info["candidates"]
             if c.get("scope") == "lan" and c.get("url")]

    # On the Hub's own LAN the LAN addresses lead, so the next run reaches it
    # directly. Anywhere else the address that just worked stays in front:
    # from outside, a `.local` name or a 192.168.x.x is not merely slower, it
    # is unreachable, and probing it would cost a timeout on every command.
    order = (local if info.get("client_local") else []) + [base] + fresh
    ordered: list[str] = []
    for url in order:
        if url and url not in ordered:
            ordered.append(url)

    if ordered != _hub_candidates():
        write_text(CONFIG_FILE, "\n".join(ordered) + "\n")
    else:
        # Unchanged, but confirmed fresh — restart the TTL so the next command
        # does not ask again.
        try:
            os.utime(CONFIG_FILE, None)
        except OSError:
            pass

    if ordered[0] != base and _is_alive(ordered[0]):
        return ordered[0]
    return base


def hub_url() -> str:
    """First reachable Hub address, cached for the life of the process.

    With a single candidate we skip the probe (fast path, matches an explicit
    override). With several — the install-time list — we probe in order and use
    the first that answers, so a changed server IP self-heals via the stable
    mDNS/Tailscale name without the user touching anything.

    Whenever the preferred address did not answer, or the saved list has gone
    stale, the Hub is asked to restate its current addresses (see
    `_refresh_candidates`) — that is the only way a client learns the box's new
    IP, or that it is now sitting on the same LAN as the Hub."""
    global _hub_cache
    if _hub_cache:
        return _hub_cache
    candidates = _hub_candidates()
    chosen: str | None = None
    fell_back = False
    if len(candidates) == 1:
        chosen = candidates[0]
    else:
        for i, base in enumerate(candidates):
            if _is_alive(base):
                chosen, fell_back = base, i > 0
                break
    if chosen is None:
        _hub_cache = candidates[0]  # nothing answered — most stable candidate
        return _hub_cache

    # Set the cache before refreshing: _refresh_candidates issues a Hub request,
    # and hub_request → api_base → hub_url would otherwise recurse.
    _hub_cache = chosen
    if os.environ.get("SAH_HUB"):
        return _hub_cache  # explicit override: never rewrite the saved list
    age = _config_age()
    if age is not None and (fell_back or age > HUB_REFRESH_TTL):
        _hub_cache = _refresh_candidates(chosen)
    return _hub_cache


def api_base() -> str:
    return f"{hub_url()}/v1"


# ----------------------------------------------------------------- self-update


def self_update() -> None:
    """Replace this script with the Hub's copy when they differ, then re-run.

    The Hub serves the sah its own features expect, so a client that has
    drifted behind it updates itself on the next run instead of waiting for
    the installer to be run again. The check is one small request: the Hub
    answers /sah/version with the sha256 of the sah it serves. Anything that
    goes wrong — offline, an older Hub without that route, an install this
    user cannot write — leaves the running copy as it is. SAH_NO_UPDATE=1
    turns the check off.
    """
    if os.environ.get("SAH_NO_UPDATE"):
        return
    path = Path(__file__).resolve()
    try:
        with urllib.request.urlopen(hub_request(f"{hub_url()}/sah/version"), timeout=2) as r:
            wanted = r.read().decode().strip()
        if (not re.fullmatch(r"[0-9a-f]{64}", wanted)
                or hashlib.sha256(path.read_bytes()).hexdigest() == wanted):
            return
        with urllib.request.urlopen(hub_request(f"{hub_url()}/sah/sah"), timeout=15) as r:
            fresh = r.read()
        if hashlib.sha256(fresh).hexdigest() != wanted:
            return  # the Hub's copy changed mid-check; the next run gets it
        tmp = path.with_name(f".{path.name}.new")
        tmp.write_bytes(fresh)
        tmp.chmod(path.stat().st_mode)
        os.replace(tmp, path)
    except (urllib.error.URLError, TimeoutError, OSError, ValueError):
        return
    print("sah: updated to the Hub's current version", file=sys.stderr)
    os.execv(sys.executable, [sys.executable, str(path), *sys.argv[1:]])


