        settings = self.settings_path()
        settings.parent.mkdir(parents=True, exist_ok=True)
        settings.parent.chmod(0o700)
        write_text(settings, yaml_dump(self.settings(model)))
        settings.chmod(0o600)
        patch = self.patch_path()
        write_text(patch, yaml_dump([
            {"id": "settings", "config": {"path": str(settings)}},
            {"insert": [{
                "id": "mcp-sah",
                "name": "@deepseek-ai/dsh-mcp-client",
                "config": {
                    "serverName": MCP_SERVER,
                    "transport": "streamable-http",
                    "url": mcp_url(),
                    "headers": mcp_headers(),
                    "toolCallTimeoutMs": MCP_TOOL_TIMEOUT * 1000,
                },
            }]},
        ]))
        patch.chmod(0o600)
        return patch

    def env(self, model: Model) -> dict:
        return {self.API_KEY_ENV: API_KEY}

    def argv(self, model: Model, extra: list[str]) -> list[str]:
        reject_managed_flags(extra, ("--patch",), "sah dsh")
        return ["web", "--patch", str(self.write_config(model)), *extra]

    def extras(self) -> tuple[tuple[str, str], ...]:
        return (("Launch settings", str(self.settings_path())),)


