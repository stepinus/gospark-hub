# --------------------------------------------------------------- launcher menu

# Bare `sah` opens this menu, as bare `ollama launch` does (cmd/tui/tui.go):
# these four lead and the rest follow in registry order, installed clients sit
# above missing ones, and only the first five show until the cursor reaches
# "More...". The client picked last time starts under the cursor.
MENU_LEAD = ("claude", "opencode", "hermes", "openclaw")
MENU_LIMIT = 5
LAST_FILE = CONFIG_DIR / "last"

_BOLD, _GREY, _HELP, _ITALIC, _RESET = (
    "\x1b[1m", "\x1b[38;5;245m", "\x1b[38;5;244m", "\x1b[3m", "\x1b[0m")


def _menu_items() -> list[tuple[Integration, bool]]:
    """(integration, installed) in menu order. Like Ollama, an integration that
    cannot run on this system is not offered at all. A desktop app sah cannot
    detect ("n/a") sits between the clients found and the ones missing."""
    shown = [i for i in INTEGRATIONS if not i.hidden and i.supported() is None]
    shown.sort(key=lambda i: MENU_LEAD.index(i.name) if i.name in MENU_LEAD else len(MENU_LEAD))
    found = {i.name: i.availability() for i in shown}
    shown.sort(key=lambda i: ("yes", "n/a", "missing").index(found[i.name]))
    return [(i, found[i.name] != "missing") for i in shown]


def _read_key() -> str:
    """One keypress: "up", "down", "enter", "quit", or the character typed."""
    if sys.platform == "win32":
        import msvcrt
        ch = msvcrt.getwch()
        if ch in ("\x00", "\xe0"):
            return {"H": "up", "P": "down"}.get(msvcrt.getwch(), "")
    else:
        import select
        import termios
        import tty
        fd = sys.stdin.fileno()
        saved = termios.tcgetattr(fd)
        try:
            tty.setraw(fd)
            ch = os.read(fd, 1).decode(errors="ignore")
            # An arrow arrives as ESC [ A; a lone ESC is the user backing out.
            if ch == "\x1b" and select.select([fd], [], [], 0.05)[0]:
                seq = os.read(fd, 2).decode(errors="ignore")
                return {"[A": "up", "[B": "down", "OA": "up", "OB": "down"}.get(seq, "")
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, saved)
    return {"\r": "enter", "\n": "enter", " ": "enter", "k": "up", "j": "down",
            "\x1b": "quit", "q": "quit", "\x03": "quit", "\x04": "quit"}.get(ch, ch)


def launcher_menu() -> list[str] | None:
    """Let the user pick a client; returns the sah arguments that run it, or
    None if they backed out. A desktop app that sah cannot start is wired with
    --install instead, which is all `sah <app>` can do for it."""
    items = _menu_items()
    try:
        last = LAST_FILE.read_text().strip()
    except OSError:
        last = ""
    names = [i.name for i, _ in items]
    cursor = names.index(last) if last in names else 0
    expanded = cursor >= MENU_LIMIT
    top = 0  # first item on screen when the list is taller than the terminal

    info = current_model_info()
    model = info["id"] if info else "no model running, launch one in the Hub"

    if sys.platform == "win32":
        os.system("")  # turns on ANSI escape handling in the Windows console
    out = sys.stdout
    drawn = 0
    out.write("\x1b[?25l")  # hide the terminal cursor while the menu is up
    try:
        while True:
            rows: list[tuple[Integration, bool] | None] = (
                items if expanded or len(items) <= MENU_LIMIT
                else [*items[:MENU_LIMIT], None])  # None is "More..."
            cols, height = shutil.get_terminal_size()
            fit = max(1, (height - 5) // 3)  # header 2, help 2, 3 lines a row
            top = min(max(top, cursor - fit + 1), cursor)

            def clip(text: str, indent: int = 0) -> str:
                return text[:max(1, cols - 1 - indent)]

            lines = [f"{_BOLD}{clip(PROVIDER_NAME)}{_RESET}  {_GREY}{clip(model, len(PROVIDER_NAME) + 2)}{_RESET}", ""]
            for idx in range(top, min(len(rows), top + fit)):
                row, here = rows[idx], idx == cursor
                mark = "▸ " if here else "  "
                if row is None:
                    title, note, desc, style = "More...", "", "Show additional integrations", ""
                else:
                    integration, installed = row
                    verb = "Launch" if integration.launchable else "Set up"
                    title, style = f"{verb} {integration.display}", (_BOLD if here else "")
                    desc, note = integration.description, ""
                    if not installed:
                        style, note = _GREY, " (not installed)"
                        if here:
                            desc = f"Install: {integration.install_hint}" if integration.install_hint else "not installed"
                lines.append(f"{style}{clip(mark + title)}{_RESET}"
                             + (f"{_GREY}{_ITALIC}{note}{_RESET}" if note else ""))
                lines.append(f"    {_GREY}{clip(desc, 4)}{_RESET}")
                lines.append("")
            if not rows:
                lines.append("No apps available.")
            lines += ["", f"{_HELP}{clip('↑/↓ navigate • enter launch • esc quit')}{_RESET}"]

            out.write((f"\x1b[{drawn}F" if drawn else "") + "\x1b[J" + "\n".join(lines) + "\n")
            out.flush()
            drawn = len(lines)

            key = _read_key()
            if key == "quit":
                return None
            if key == "up" and cursor > 0:
                cursor -= 1
                if expanded and cursor < MENU_LIMIT:
                    expanded, top = False, 0
            elif key == "down" and cursor < len(rows) - 1:
                cursor += 1
                # Reaching "More..." opens it, exactly as in Ollama's menu.
                if rows[cursor] is None:
                    expanded = True
            elif key == "enter" and rows and rows[cursor] and rows[cursor][1]:
                integration = rows[cursor][0]
                try:
                    write_text(LAST_FILE, integration.name + "\n")
                except OSError:
                    pass
                if not integration.launchable:
                    return [integration.name, "--install"]
                # An editor opens the folder sah was run from, as `sah <name> .` does.
                return [integration.name, *(["."] if integration.opens_folder else [])]
    finally:
        out.write((f"\x1b[{drawn}F" if drawn else "") + "\x1b[J\x1b[?25h")
        out.flush()


# ------------------------------------------------------------------ entrypoint


def _add_integration_parser(sub, integration: Integration):
    verb = "Launch" if integration.launchable else "Manage"
    parser = sub.add_parser(
        integration.name,
        aliases=list(integration.aliases),
        help=f"{verb} {integration.display} through {PROVIDER_NAME}",
        description=f"{verb} {integration.display} through {PROVIDER_NAME}.",
    )
    group = parser.add_mutually_exclusive_group()
    persistent = integration.writes_config
    group.add_argument("--install", action="store_true",
                       help=(f"Make the plain {integration.display} use {PROVIDER_NAME}"
                             if persistent else
                             f"Not available: {integration.display} is launch only"))
    group.add_argument("--restore", action="store_true",
                       help=(f"Restore previous plain {integration.display} settings"
                             if persistent else
                             f"Not available: {integration.display} is launch only"))
    group.add_argument("--status", action="store_true",
                       help=f"Show {PROVIDER_NAME} wiring status for {integration.display}")
    integration.add_arguments(parser)
    if integration.launchable:
        parser.add_argument("passthrough", nargs=argparse.REMAINDER, metavar="args",
                            help=f"Arguments passed to {integration.display}")
    parser.set_defaults(func=integration.run)
    return parser


def main() -> None:
    # Before parsing, so a sah too old to know the command just typed — bare
    # `sah` included — still updates and then runs it. set-hub and set-key
    # change how the Hub is reached; checking first would use the address or
    # key being replaced.
    if sys.argv[1:2] not in (["set-hub"], ["set-key"]):
        self_update()

    parser = argparse.ArgumentParser(
        prog="sah",
        description=f"{PROVIDER_NAME} client launcher",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Menu:\n"
            "  sah                       Pick a client from a menu and launch it\n"
            "\n"
            "Lifecycle:\n"
            "  sah <client>              Configure the client for the Hub and launch it\n"
            "  sah <client> --install    Configure only, so the plain client uses the Hub\n"
            "  sah <client> --status     Show wiring status for the client\n"
            "  sah <client> --restore    Put the client's original settings back\n"
            "\n"
            "Client args:\n"
            "  sah <client> -- <args>    Pass args to the underlying client\n"
            "\n"
            "Discover integrations:\n"
            "  sah integrations          List every integration's mode and commands\n"
            "\n"
            "Models:\n"
            "  sah models                List every running model; sah <client> uses the biggest\n"
        ),
    )
    sub = parser.add_subparsers(dest="cmd", title="commands", metavar="<command>")

    sp = sub.add_parser("info", help="Show Hub URL and current model")
    sp.set_defaults(func=cmd_info)

    sp = sub.add_parser("models", aliases=["ps"], help="List every running model")
    sp.set_defaults(func=cmd_models)

    sp = sub.add_parser("env", help="Print Hub environment variables")
    sp.add_argument("--anthropic", action="store_true", help="Anthropic-shaped env vars")
    sp.set_defaults(func=cmd_env)

    sp = sub.add_parser("mcp", help="Show the Hub's MCP server details")
    sp.add_argument("--json", action="store_true", help="Print only the mcpServers JSON")
    sp.set_defaults(func=cmd_mcp)

    sp = sub.add_parser("integrations", aliases=["clients"],
                        help="List integration modes and lifecycle commands")
    sp.set_defaults(func=cmd_integrations)

    sp = sub.add_parser("set-key", help=f"Save your {PROVIDER_NAME} API key")
    sp.add_argument("key", help="The API key from the Hub's Account page")
    sp.set_defaults(func=cmd_set_key)

    sp = sub.add_parser("refresh-hub",
                        help="Re-read the Hub's current addresses and re-sort them")
    sp.set_defaults(func=cmd_refresh_hub)

    sp = sub.add_parser("set-hub", help=f"Set the {PROVIDER_NAME} URL")
    sp.add_argument("url")
    sp.set_defaults(func=cmd_set_hub)

    for integration in INTEGRATIONS:
        _add_integration_parser(sub, integration)

    args, extras = parser.parse_known_args()
    if args.cmd is None and not extras:
        # Bare `sah` opens the launcher menu, as bare `ollama launch` does.
        if not (sys.stdin.isatty() and sys.stdout.isatty()):
            parser.print_help(sys.stderr)
            sys.exit(2)
        if not (picked := launcher_menu()):
            return
        args, extras = parser.parse_known_args(picked)
    if hasattr(args, "passthrough"):
        args.passthrough = [*extras, *args.passthrough]
    elif extras or args.cmd is None:
        parser.error(f"unrecognized arguments: {' '.join(extras)}")
    args.func(args)


if __name__ == "__main__":
    main()
