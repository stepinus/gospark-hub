class Pi(Integration):
    """Ollama's cmd/launch/pi.go: providers.<id> in ~/.pi/agent/models.json with
    a `_launch` marker on the entries it owns, and defaults in settings.json.
    User-added models in the same file are preserved."""
    name, display, binary = "pi", "Pi Coding Agent", "pi"
    description = "Minimal AI agent toolkit with plugin support"
    install_hint = "npm install -g @earendil-works/pi-coding-agent@latest"
    writes_config = True

    def agent_dir(self) -> Path:
        return Path.home() / ".pi" / "agent"

    def files(self) -> dict[str, Path]:
        return {
            "pi-models": self.agent_dir() / "models.json",
            "pi": self.agent_dir() / "settings.json",
        }

    def configure(self, model: Model) -> None:
        paths = self.files()
        config = read_json(paths["pi-models"])
        providers = config.get("providers") if isinstance(config.get("providers"), dict) else {}
        provider = providers.get(PROVIDER) if isinstance(providers.get(PROVIDER), dict) else {}
        provider["baseUrl"] = api_base()
        provider["api"] = "openai-completions"
        # pi hides models whose provider has no auth configured; the Hub ignores
        # the key, so a placeholder is what makes them selectable.
        provider["apiKey"] = API_KEY

        kept = [
            m for m in (provider.get("models") or [])
            if isinstance(m, dict) and not m.get("_launch")
        ]
        provider["models"] = [*(self.entry(m) for m in model.all), *kept]
        providers[PROVIDER] = provider
        config["providers"] = providers
        write_json(paths["pi-models"], config)

        settings = read_json(paths["pi"])
        settings["defaultProvider"] = PROVIDER
        # Hub model ids carry a slash (`poolside/Laguna-XS-2.1-NVFP4`) and
        # `pi --model` reads a leading slash segment as a provider name, so the
        # model is pinned here rather than on the command line.
        settings["defaultModel"] = model.name
        write_json(paths["pi"], settings)

    @staticmethod
    def entry(model: Model) -> dict:
        entry: dict = {"id": model.name, "_launch": True, "input": model.input_modalities()}
        if model.has("thinking"):
            entry["reasoning"] = True
        if model.context_length:
            entry["contextWindow"] = model.context_length
        return entry

    def wired(self) -> bool:
        models = read_json(self.files()["pi-models"])
        provider = (models.get("providers") or {}).get(PROVIDER)
        settings = read_json(self.files()["pi"])
        return (isinstance(provider, dict) and provider.get("baseUrl") == api_base()
                and settings.get("defaultProvider") == PROVIDER)


