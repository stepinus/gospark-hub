class VSCode(Integration):
    """Ollama's cmd/launch/vscode.go: one group in VS Code's
    chatLanguageModels.json, then open VS Code. Ollama's group uses the
    built-in `ollama` vendor, which speaks the Ollama native API; sah's uses
    the built-in `customendpoint` vendor ("Custom Endpoint"), which takes an
    OpenAI-compatible URL. VS Code now lists `ollama` as deprecated.

    The key goes in each model's Authorization request header, which Custom
    Endpoint sends in place of its own. A group's `apiKey` cannot carry it:
    VS Code reads that field back only from its own encrypted secret store,
    which nothing outside VS Code can write. The Hub's MCP server goes in the
    user mcp.json, which VS Code shares between chat and agent mode.

    `sah vscode` leaves the user's VS Code untouched: it runs VS Code with
    --user-data-dir on a sah-owned folder whose User directory is built from
    the user's own (read, never written) plus the Hub wiring. --install is the
    deliberate, permanent version that edits the user's real files."""
    name, display, binary = "vscode", "Visual Studio Code", "code"
    description = "Microsoft's open-source AI code editor"
    aliases = ("code",)
    kind = "Desktop"
    install_hint = "https://code.visualstudio.com"
    writes_config = True
    opens_folder = True

    VENDOR = "customendpoint"

    def find_binary(self) -> str | None:
        """PATH first, then where the installers put it, as Ollama looks. The
        macOS app does not add `code` to PATH until you run "Shell Command:
        Install 'code' command in PATH", so the bundle's own CLI is used."""
        if path := shutil.which("code"):
            return path
        if sys.platform == "darwin":
            app = Path("Visual Studio Code.app") / "Contents/Resources/app/bin/code"
            candidates = [Path("/Applications") / app, Path.home() / "Applications" / app]
        elif sys.platform == "win32":
            local = os.environ.get("LOCALAPPDATA") or ""
            candidates = [Path(local) / "Programs/Microsoft VS Code/bin/code.cmd"] if local else []
        else:
            candidates = [Path("/usr/bin/code"), Path("/snap/bin/code")]
        return next((str(c) for c in candidates if c.is_file()), None)

    def user_dir(self) -> Path:
        if sys.platform == "darwin":
            return Path.home() / "Library" / "Application Support" / "Code" / "User"
        if sys.platform == "win32":
            return Path(os.environ.get("APPDATA") or Path.home()) / "Code" / "User"
        return Path.home() / ".config" / "Code" / "User"

    def files(self) -> dict[str, Path]:
        return {
            "vscode": self.user_dir() / "chatLanguageModels.json",
            "vscode-mcp": self.user_dir() / "mcp.json",
        }

    def is_mine(self, group) -> bool:
        return (isinstance(group, dict) and group.get("vendor") == self.VENDOR
                and group.get("name") == PROVIDER_NAME)

    @staticmethod
    def entry(model: Model) -> dict:
        return {
            "id": model.name,
            "name": model.name,
            "url": api_base(),
            "toolCalling": model.has("tools"),
            "vision": model.has("vision"),
            "thinking": model.has("thinking"),
            "contextWindow": model.context(),
            "maxOutputTokens": model.max_output(),
            "requestHeaders": {"Authorization": f"Bearer {API_KEY}"},
        }

    def configure(self, model: Model) -> None:
        self.write_wiring(model, self.user_dir())

    def write_wiring(self, model: Model, into: Path) -> None:
        """The Hub's model group and MCP server, merged into the user's own
        chatLanguageModels.json and mcp.json and written to `into`."""
        src = self.user_dir()
        groups = read_json(src / "chatLanguageModels.json")
        groups = [g for g in groups if not self.is_mine(g)] if isinstance(groups, list) else []
        groups.append({
            "name": PROVIDER_NAME,
            "vendor": self.VENDOR,
            "models": [self.entry(m) for m in model.all],
        })
        write_json(into / "chatLanguageModels.json", groups)

        mcp = read_json(src / "mcp.json")
        servers = mcp.get("servers") if isinstance(mcp.get("servers"), dict) else {}
        servers[MCP_SERVER] = {"type": "http", "url": mcp_url(), "headers": mcp_headers()}
        mcp["servers"] = servers
        write_json(into / "mcp.json", mcp)

    # -- launch: a sah-owned VS Code data folder -------------------------------

    # Linked through from the user's User directory, so a sah window has their
    # keybindings, snippets, tasks and prompt files. Everything else VS Code
    # keeps there (state databases, history, workspace storage) stays separate:
    # two running VS Codes must not share it.
    SHARED = ("keybindings.json", "snippets", "tasks.json", "prompts")

    def data_dir(self) -> Path:
        return CONFIG_DIR / "vscode"

    def prepare_data_dir(self, model: Model) -> Path:
        user = self.data_dir() / "User"
        user.mkdir(parents=True, exist_ok=True)
        real = self.user_dir()
        for name in self.SHARED:
            link, target = user / name, real / name
            if link.is_symlink() and (not target.exists() or Path(os.readlink(link)) != target):
                link.unlink()
            if target.exists() and not link.exists() and not link.is_symlink():
                link.symlink_to(target)

        self.write_wiring(model, user)
        # The user's settings, plus chat starting on the Hub's model.
        # `chat.defaultModel` matches on the model id. Copilot CLI sessions are
        # left off as the default because they publish a Custom Endpoint model
        # late and then fall back to Auto; the session picker still offers them.
        settings = read_json(real / "settings.json")
        settings["chat.defaultModel"] = model.name
        settings["chat.defaultToCopilotHarness"] = False
        write_json(user / "settings.json", settings)
        return self.data_dir()

    def wired(self) -> bool:
        groups = read_json(self.files()["vscode"])
        return isinstance(groups, list) and any(
            self.is_mine(g) and any(isinstance(m, dict) and m.get("url") == api_base()
                                    for m in g.get("models") or [])
            for g in groups
        )

    def launch(self, model: Model, extra: list[str]) -> None:
        # Ollama's same warning: agent mode lists only tool-calling models.
        if not model.has("tools"):
            print(f"Note: the Hub does not report tool calling for {model.name}, "
                  f"so it may not appear in VS Code's agent mode.", file=sys.stderr)
        reject_managed_flags(extra, ("--user-data-dir", "--profile"), "sah vscode")
        path = self.require_binary()
        data = self.prepare_data_dir(model)
        os.execve(path, [self.binary or path, "--user-data-dir", str(data), *extra], os.environ)

    def extras(self) -> tuple[tuple[str, str], ...]:
        return (("Models", f"chat model picker → {PROVIDER_NAME} (Manage Models if hidden)"),)


