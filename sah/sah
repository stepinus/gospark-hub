def cmd_refresh_hub(_args) -> None:
    """Force the periodic address refresh that hub_url() does on its own."""
    candidates = _hub_candidates()
    base = next((c for c in candidates if _is_alive(c)), None)
    if base is None:
        sys.exit(
            f"No Hub answered on any saved address:\n    "
            + "\n    ".join(candidates)
            + "\n\nCheck the Hub is running, or point sah at it with: sah set-hub <url>"
        )
    global _hub_cache
    _hub_cache = base
    _hub_cache = _refresh_candidates(base)
    kv("Hub", _hub_cache)
    if others := [c for c in _hub_candidates() if c != _hub_cache]:
        kv("Fallback hubs", ", ".join(others))


