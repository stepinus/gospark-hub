CHATGPT_PROVIDER = "sah-chatgpt"
CHATGPT_BUNDLE_ID = "com.openai.codex"


class ChatGPT(Integration):
    """Ollama's cmd/launch/codex_app.go. The desktop app reads the ROOT table of
    ~/.codex/config.toml (not a --profile), so wiring it is inherently
    persistent. It uses its own provider name and catalog file, and `sah codex`
    no longer touches the root table at all, so the two coexist."""
    name, display = "chatgpt", "ChatGPT"
    description = "Use Hub models in ChatGPT"
    aliases = ("codex-app", "codex-desktop", "codex-gui")
    kind = "Desktop"
    binary = None
    launchable = False
    writes_config = True

    def supported(self) -> str | None:
        if sys.platform not in ("darwin", "win32"):
            return ("sah chatgpt is macOS/Windows-only — OpenAI does not ship a Linux "
                    "build of the ChatGPT desktop app. Run it on the machine that has "
                    "it installed. (For the terminal agent, use: sah codex)")
        return None

    def config_path(self) -> Path:
        return Path.home() / ".codex" / "config.toml"

    def catalog_path(self) -> Path:
        return Path.home() / ".codex" / "sah-chatgpt-models.json"

    def files(self) -> dict[str, Path]:
        return {"chatgpt": self.config_path()}

    def app_path(self) -> Path | None:
        if sys.platform != "darwin":
            return None
        for parent in (Path("/Applications"), Path.home() / "Applications"):
            for app in ("ChatGPT.app", "Codex.app"):
                if (parent / app).is_dir():
                    return parent / app
        return None

    def running(self) -> bool:
        if sys.platform != "darwin":
            return False
        result = subprocess.run(["pgrep", "-f", r"(ChatGPT|Codex)\.app/Contents/MacOS/"],
                                capture_output=True, text=True)
        return result.returncode == 0 and bool(result.stdout.strip())

    def catalog_entry(self, model: Model) -> dict:
        ctx = model.context(128000)
        return {
            "slug": model.name,
            "display_name": model.name,
            "description": f"Served by {PROVIDER_NAME}",
            "default_reasoning_level": None,
            "supported_reasoning_levels": [],
            "shell_type": "default",
            "visibility": "list",
            "supported_in_api": True,
            "priority": 0,
            "additional_speed_tiers": [],
            "availability_nux": None,
            "upgrade": None,
            "base_instructions": ("You are Codex, a coding agent. You and the user share "
                                  "the same workspace and collaborate to achieve the "
                                  "user's goals."),
            "model_messages": None,
            "supports_reasoning_summaries": False,
            "default_reasoning_summary": "auto",
            "support_verbosity": False,
            "default_verbosity": None,
            "apply_patch_tool_type": None,
            "web_search_tool_type": "text",
            "truncation_policy": {"mode": "bytes", "limit": 10000},
            "supports_parallel_tool_calls": False,
            "supports_image_detail_original": False,
            "context_window": ctx,
            "max_context_window": ctx,
            "auto_compact_token_limit": None,
            "effective_context_window_percent": 95,
            "experimental_supported_tools": [],
            "input_modalities": model.input_modalities(),
            "supports_search_tool": False,
        }

    def configure(self, model: Model) -> None:
        write_json(self.catalog_path(), {"models": [self.catalog_entry(m) for m in model.all]})
        cfg = self.config_path()
        text = cfg.read_text() if cfg.is_file() else ""
        # A stale `profile` at the root would override everything set here.
        text = toml_remove_root(text, "profile")
        text = toml_set_root_string(text, "model", model.name)
        text = toml_set_root_string(text, "model_provider", CHATGPT_PROVIDER)
        text = toml_set_root_string(text, "model_catalog_json", str(self.catalog_path()))
        text = toml_upsert_section(text, f"[model_providers.{CHATGPT_PROVIDER}]", [
            f"name = {json.dumps(PROVIDER_NAME)}",
            f"base_url = {json.dumps(api_base().rstrip('/') + '/')}",
            'wire_api = "responses"',
            # A literal header rather than Codex's env_key, because this is the
            # desktop app: it is started by the OS from the desktop session, so
            # it never sees an environment sah could put OPENAI_API_KEY into.
            # `sah codex` keeps using env_key, which leaves the key out of the
            # file entirely — it can set the variable because it does the exec.
            "http_headers = { Authorization = " + json.dumps(f"Bearer {API_KEY}") + " }",
        ])
        toml_validate(text, cfg)
        write_text(cfg, text)

    def wired(self) -> bool:
        cfg = self.config_path()
        text = cfg.read_text() if cfg.is_file() else ""
        return f'model_provider = "{CHATGPT_PROVIDER}"' in text.split("\n[", 1)[0]

    def extras(self) -> tuple[tuple[str, str], ...]:
        app = self.app_path()
        return (
            ("ChatGPT app", f"installed at {app}" if app else "not found"),
            ("ChatGPT running", "yes" if self.running() else "no"),
        )

    def restart(self, skip: bool) -> None:
        if skip or sys.platform != "darwin":
            print("Quit and reopen ChatGPT for the change to take effect.")
            return
        if self.running():
            print("Restarting ChatGPT", end="", flush=True)
            for app in ("ChatGPT", "Codex"):
                subprocess.run(["osascript", "-e", f'tell application "{app}" to quit'],
                               check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            deadline = time.time() + 30
            while time.time() < deadline and self.running():
                print(".", end="", flush=True)
                time.sleep(1.0)
            print(" done.")
        app = self.app_path()
        subprocess.run(["open", str(app)] if app else ["open", "-b", CHATGPT_BUNDLE_ID], check=False)

    def add_arguments(self, parser) -> None:
        parser.add_argument("--no-restart", action="store_true",
                            help="Skip the automatic ChatGPT restart")

    def run(self, args) -> None:
        if reason := self.supported():
            sys.exit(reason)
        if args.status:
            self.status()
            return
        if args.restore:
            if self.restore_all():
                self.restart(skip=args.no_restart)
            return
        if not args.install:
            sys.exit("Choose one: sah chatgpt --install, --status, or --restore")
        self.install(require_model())
        self.restart(skip=args.no_restart)

    def restore_all(self) -> bool:
        if not restore_backup("chatgpt", self.config_path()):
            print(f"No {PROVIDER_NAME} chatgpt wiring found; nothing to restore.")
            return False
        if self.catalog_path().is_file():
            self.catalog_path().unlink()
        print("ChatGPT restored to your usual profile.")
        return True


