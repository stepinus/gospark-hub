# Generated by Spark AI Hub — edits here are overwritten on restart.
{
	admin 0.0.0.0:2019
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:9100 {
	# acestep
	@probe-acestep {
		path /run/acestep/*
		header X-Sah-Probe "<token>"
	}
	handle @probe-acestep {
		uri strip_prefix /run/acestep
		reverse_proxy spark-ai-hub-acestep:7860
	}
	redir /run/acestep /run/acestep/ 308
	handle_path /run/acestep/* {
		forward_auth host.docker.internal:9110 {
			uri /api/auth/me
			@denied status 401 403
			handle_response @denied {
				redir * / 302
			}
		}
		reverse_proxy spark-ai-hub-acestep:7860
	}

